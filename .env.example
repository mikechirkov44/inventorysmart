# InventorySmart - Переменные окружения
# Скопируйте в .env и измените значения

# Порт приложения (по умолчанию: 80)
APP_PORT=80

# Порт базы данных (по умолчанию: 5433)
DB_PORT=5433

# Настройки PostgreSQL
POSTGRES_DB=inventorysmart
POSTGRES_USER=inventorysmart
POSTGRES_PASSWORD=inventorysmart_secret

# Секретный ключ JWT (обязательно смените в продакшене!)
JWT_SECRET=inventorysmart-secret-key-2026

# Автосоздание администратора при первом запуске
# Если ADMIN_PASSWORD задан — администратор создаётся автоматически
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULLNAME=Администратор

# Суперадмин (доступ к панели управления /admin/)
# Логин и пароль по умолчанию: superadmin / superadmin123
# Рекомендуется сменить пароль после первого входа
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin123
